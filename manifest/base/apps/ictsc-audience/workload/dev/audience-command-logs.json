{
  "uid": "audience-command-logs",
  "title": "Audience コマンドログ",
  "schemaVersion": 41,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "受信ログ件数",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "audience-victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "audience-victorialogs"
          },
          "expr": "* | stats count()",
          "queryType": "statsRange"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 2,
      "title": "コマンドログ",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "audience-victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "audience-victorialogs"
          },
          "expr": "*",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLogDetails": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
